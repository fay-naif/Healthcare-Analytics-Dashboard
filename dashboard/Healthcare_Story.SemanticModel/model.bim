        "measures": [
          {
            "name": "Visits",
            "expression": "COUNTROWS ( Visits )",
            "displayFolder": "Core",
            "lineageTag": "519cd063-7c27-4245-bb0b-7c047160fd9e",
            "formatString": "#,0"
          },
          {
            "name": "Patients",
            "expression": "DISTINCTCOUNT ( Visits[Patient_ID] )",
            "displayFolder": "Core",
            "lineageTag": "d88727ce-2679-4f8a-8505-e6624372b3e2",
            "formatString": "#,0"
          },
          {
            "name": "Hospitals",
            "expression": "DISTINCTCOUNT ( Visits[Facility_Name] )",
            "displayFolder": "Core",
            "lineageTag": "18fabf36-26c8-4771-9bd6-62fdb39c90c8",
            "formatString": "0"
          },
          {
            "name": "Doctors",
            "expression": "DISTINCTCOUNT ( Visits[Provider_ID] )",
            "displayFolder": "Core",
            "lineageTag": "88bb32c6-2de8-4b8f-bb29-ec4c5d630fb5",
            "formatString": "0"
          },
          {
            "name": "Total Billed",
            "expression": "SUM ( Visits[Charge_SAR] )",
            "displayFolder": "Money",
            "lineageTag": "e5ee062b-edec-4505-a7dd-8ed5d5fd3c1b",
            "formatString": "#,0"
          },
          {
            "name": "Total Collected",
            "expression": "SUM ( Visits[Collected_SAR] )",
            "displayFolder": "Money",
            "lineageTag": "a6b8b66d-879c-4e13-9e91-75b9666ba86c",
            "formatString": "#,0"
          },
          {
            "name": "Uncollected",
            "expression": "[Total Billed] - [Total Collected]",
            "displayFolder": "Money",
            "lineageTag": "708d878b-4054-426d-8f11-8b2c568052ce",
            "formatString": "#,0"
          },
          {
            "name": "Collection Rate",
            "expression": "DIVIDE ( [Total Collected], [Total Billed] )",
            "displayFolder": "Money",
            "lineageTag": "2a3a6480-7bc2-4411-a002-c33de88de674",
            "formatString": "0.0%"
          },
          {
            "name": "Uncollected %",
            "expression": "DIVIDE ( [Uncollected], [Total Billed] )",
            "displayFolder": "Money",
            "lineageTag": "3b9e086c-9048-4c48-945b-8324f7f4915b",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Bill",
            "expression": "AVERAGE ( Visits[Charge_SAR] )",
            "displayFolder": "Money",
            "lineageTag": "dcf614cd-009c-400a-84ea-436815b39638",
            "formatString": "#,0"
          },
          {
            "name": "Visit Share",
            "expression": "DIVIDE ( [Visits], CALCULATE ( [Visits], REMOVEFILTERS ( Visits[Service_Name] ) ) )",
            "displayFolder": "Money",
            "lineageTag": "c0494ee3-cad0-4156-9243-f21f4c67513b",
            "formatString": "0.0%"
          },
          {
            "name": "Revenue Share",
            "expression": "DIVIDE ( [Total Billed], CALCULATE ( [Total Billed], REMOVEFILTERS ( Visits[Service_Name] ) ) )",
            "displayFolder": "Money",
            "lineageTag": "6f035f08-4df1-444d-8c73-ba29b5cff9b4",
            "formatString": "0.0%"
          },
          {
            "name": "Gap Share",
            "expression": "DIVIDE ( [Uncollected], CALCULATE ( [Uncollected], REMOVEFILTERS ( Visits[Service_Name] ) ) )",
            "displayFolder": "Money",
            "lineageTag": "d351913f-0632-4414-bd97-b62de22c3cb9",
            "formatString": "0.0%"
          },
          {
            "name": "Procedure Revenue Share",
            "expression": "CALCULATE ( [Revenue Share], Visits[Service_Name] = \"Procedure\" )",
            "displayFolder": "Money",
            "lineageTag": "801fda0a-500b-4355-8681-513804b4e8d7",
            "formatString": "0.0%"
          },
          {
            "name": "Bills Paid in Full",
            "expression": "COUNTROWS ( FILTER ( Visits, Visits[Collected_SAR] >= Visits[Charge_SAR] ) ) + 0",
            "displayFolder": "Money",
            "lineageTag": "b5f7cd8a-9012-454d-875b-c5d57cb4b2d2",
            "formatString": "#,0"
          },
          {
            "name": "% Bills Under 60% Collected",
            "expression": "DIVIDE ( COUNTROWS ( FILTER ( Visits, Visits[Collected_SAR] < 0.6 * Visits[Charge_SAR] ) ), [Visits] )",
            "displayFolder": "Money",
            "lineageTag": "e123e287-e08a-4087-b14d-b395b21c8a5e",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Wait (min)",
            "expression": "AVERAGE ( Visits[Wait_Minutes] )",
            "displayFolder": "Time",
            "lineageTag": "0df3beed-1c49-44e5-b3d5-dd41e3a38fec",
            "formatString": "0.0"
          },
          {
            "name": "% Wait 90+ min",
            "expression": "DIVIDE ( CALCULATE ( [Visits], Visits[Wait_Minutes] > 90 ), [Visits] )",
            "displayFolder": "Time",
            "lineageTag": "a1cc1d4b-4d82-47a4-9056-c6434076d460",
            "formatString": "0.0%"
          },
          {
            "name": "% Seen in 30 min",
            "expression": "DIVIDE ( CALCULATE ( [Visits], Visits[Wait_Minutes] <= 30 ), [Visits] )",
            "displayFolder": "Time",
            "lineageTag": "75c7d072-69e6-4bcd-9932-1a5a9610e41f",
            "formatString": "0.0%"
          },
          {
            "name": "ER Seen in 30 min",
            "expression": "CALCULATE ( [% Seen in 30 min], Visits[Department] = \"Emergency\" )",
            "displayFolder": "Time",
            "lineageTag": "12932c31-507f-4454-9293-8a8596e2f4ab",
            "formatString": "0.0%"
          },
          {
            "name": "ER Avg Wait (min)",
            "expression": "CALCULATE ( [Avg Wait (min)], Visits[Department] = \"Emergency\" )",
            "displayFolder": "Time",
            "lineageTag": "f49154b2-fde3-4078-ac2f-7d73848448fb",
            "formatString": "0.0"
          },
          {
            "name": "Wait - Emergency",
            "expression": "IF ( SELECTEDVALUE ( Visits[Department] ) = \"Emergency\", [Avg Wait (min)] )",
            "displayFolder": "Time",
            "lineageTag": "cca95feb-984f-4c6b-9396-919af36c874c",
            "formatString": "0.0"
          },
          {
            "name": "Wait - Other Departments",
            "expression": "IF ( SELECTEDVALUE ( Visits[Department] ) <> \"Emergency\", [Avg Wait (min)] )",
            "displayFolder": "Time",
            "lineageTag": "1d23fd37-d057-46cd-8acf-8e4a689e2f22",
            "formatString": "0.0"
          },
          {
            "name": "ER Target (30 min)",
            "expression": "30",
            "displayFolder": "Time",
            "lineageTag": "cf693cb4-b95d-443a-990b-037831699ada",
            "formatString": "0"
          },
          {
            "name": "Admissions",
            "expression": "CALCULATE ( [Visits], Visits[Outcome] = \"Admitted\" )",
            "displayFolder": "Time",
            "lineageTag": "7083e3da-ad43-4685-a56c-8e248e2591f0",
            "formatString": "#,0"
          },
          {
            "name": "Referrals",
            "expression": "CALCULATE ( [Visits], Visits[Outcome] = \"Referred\" )",
            "displayFolder": "Time",
            "lineageTag": "f90f3a5c-d2b3-47fb-8a80-cb25a14720ee",
            "formatString": "#,0"
          },
          {
            "name": "Admission Rate",
            "expression": "DIVIDE ( [Admissions], [Visits] )",
            "displayFolder": "Time",
            "lineageTag": "042a5fd2-e162-418f-9c00-9047dfa15452",
            "formatString": "0.0%"
          },
          {
            "name": "Referral Rate",
            "expression": "DIVIDE ( [Referrals], [Visits] )",
            "displayFolder": "Time",
            "lineageTag": "a11a97bf-b72b-4f3c-8d06-731d0a507813",
            "formatString": "0.0%"
          },
          {
            "name": "Total Beds",
            "expression": "SUMX ( VALUES ( Visits[Facility_Name] ), CALCULATE ( MAX ( Visits[Beds] ) ) )",
            "displayFolder": "Capacity",
            "lineageTag": "010e9778-d4f6-4f2b-bff4-f89c1a67bde2",
            "formatString": "#,0"
          },
          {
            "name": "Admissions per Bed",
            "expression": "DIVIDE ( [Admissions], [Total Beds] )",
            "displayFolder": "Capacity",
            "lineageTag": "30d84b1e-99c9-475a-95c4-e858f19f0065",
            "formatString": "0.0"
          },
          {
            "name": "Visits per Bed",
            "expression": "DIVIDE ( [Visits], [Total Beds] )",
            "displayFolder": "Capacity",
            "lineageTag": "4a8dbb28-e3bb-422e-b568-f6852b145373",
            "formatString": "0.0"
          },
          {
            "name": "Bed Load Gap (x)",
            "expression": "VAR t = ADDCOLUMNS ( ALL ( Visits[Facility_Name] ), \"apb\", [Admissions per Bed] )\nRETURN DIVIDE ( MAXX ( t, [apb] ), MINX ( t, [apb] ) )",
            "displayFolder": "Capacity",
            "lineageTag": "b50b798c-a4ea-44f9-9349-38d30ecd4b1c",
            "formatString": "0.0"
          },
          {
            "name": "Billed YoY %",
            "expression": "VAR cy = CALCULATE ( [Total Billed], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Total Billed], Visits[Year] = 2024 )\nRETURN DIVIDE ( cy - py, py )",
            "displayFolder": "Time Intelligence",
            "lineageTag": "6184e515-2f80-4fa5-b1c1-594ad5c7a3c7",
            "formatString": "0.0%"
          },
          {
            "name": "Billed YoY Label",
            "expression": "VAR d = [Billed YoY %]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0%\" ) & \"  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",
            "lineageTag": "e015a62a-e414-4ed1-9c23-5378f8512ec1"
          },
          {
            "name": "Collected YoY %",
            "expression": "VAR cy = CALCULATE ( [Total Collected], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Total Collected], Visits[Year] = 2024 )\nRETURN DIVIDE ( cy - py, py )",
            "displayFolder": "Time Intelligence",
            "lineageTag": "a6d48e81-2055-476a-a353-97c4fce8ab85",
            "formatString": "0.0%"
          },
          {
            "name": "Collected YoY Label",
            "expression": "VAR d = [Collected YoY %]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0%\" ) & \"  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",
            "lineageTag": "7593238e-68b0-4feb-829d-56c0dfb778ac"
          },
          {
            "name": "Collection Rate YoY pts",
            "expression": "VAR cy = CALCULATE ( [Collection Rate], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Collection Rate], Visits[Year] = 2024 )\nRETURN ( cy - py ) * 100",
            "displayFolder": "Time Intelligence",
            "lineageTag": "eb208f17-b02c-47ab-82be-13cf4ecedeeb",
            "formatString": "0.0"
          },
          {
            "name": "Collection Rate YoY Label",
            "expression": "VAR d = [Collection Rate YoY pts]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0\" ) & \" pts  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",
            "lineageTag": "df028a14-c934-40ad-8b6e-da9a1ebe834e"
          },
          {
            "name": "Uncollected YoY %",
            "expression": "VAR cy = CALCULATE ( [Uncollected], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Uncollected], Visits[Year] = 2024 )\nRETURN DIVIDE ( cy - py, py )",
            "displayFolder": "Time Intelligence",
            "lineageTag": "a42bfac6-9326-443a-b3fc-3147950ee4ec",
            "formatString": "0.0%"
          },
          {
            "name": "Uncollected YoY Label",
            "expression": "VAR d = [Uncollected YoY %]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0%\" ) & \"  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",
            "lineageTag": "93710b5c-e4e8-4c70-ad3b-5229e703f951"
          },
          {
            "name": "Avg Bill YoY %",
            "expression": "VAR cy = CALCULATE ( [Avg Bill], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Avg Bill], Visits[Year] = 2024 )\nRETURN DIVIDE ( cy - py, py )",
            "displayFolder": "Time Intelligence",
            "lineageTag": "a6ba0c69-9687-4766-90fd-7729a8138c8a",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Bill YoY Label",
            "expression": "VAR d = [Avg Bill YoY %]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0%\" ) & \"  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",
            "lineageTag": "9e4eb235-cac1-42b5-bd8f-6501124a395a"
          },
          {
            "name": "Avg Wait YoY %",
            "expression": "VAR cy = CALCULATE ( [Avg Wait (min)], Visits[Year] = 2025 )\nVAR py = CALCULATE ( [Avg Wait (min)], Visits[Year] = 2024 )\nRETURN DIVIDE ( cy - py, py )",
            "displayFolder": "Time Intelligence",
            "lineageTag": "c350d73a-4114-45bf-8aff-5662f58e7596",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Wait YoY Label",
            "expression": "VAR d = [Avg Wait YoY %]\nRETURN IF ( d >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( d ), \"0.0%\" ) & \"  ·  2025 vs 2024\"",
            "displayFolder": "KPI labels",

        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ADDCOLUMNS(CALENDAR(DATE(YEAR(MIN(Visits[Visit_Date])), 1, 1), DATE(YEAR(MAX(Visits[Visit_Date])), 12, 31)), \"Year\", YEAR([Date]), \"Quarter\", \"Q\" & QUARTER([Date]), \"Month Num\", MONTH([Date]), \"Month\", FORMAT([Date], \"MMM\"), \"Year Month\", FORMAT([Date], \"MMM yyyy\"), \"YearMonthNum\", YEAR([Date]) * 100 + MONTH([Date]))"
            }
          }
        ]
      }
    ],
